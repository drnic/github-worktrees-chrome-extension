{
  "name": "github-worktrees-chrome-extension",
  "version": "1.0.0",
  "description": "Enhance GitHub PR lists by showing branch names with copy-to-clipboard functionality",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "build:zip": "npm run build && cd dist && zip -r ../github-worktrees-extension.zip .",
    "clean": "rm -rf dist",
    "lint": "eslint src/ --ext .js"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "@crxjs/vite-plugin": "^2.0.0",
    "terser": "^5.0.0",
    "eslint": "^8.57.0"
  },
  "keywords": ["chrome-extension", "github", "worktrees", "git", "branches"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/github-worktrees-chrome-extension.git"
  }
}