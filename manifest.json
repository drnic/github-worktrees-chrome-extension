{
  "manifest_version": 3,
  "name": "GitHub Worktrees",
  "version": "1.0.1",
  "description": "Enhance GitHub PR lists by showing branch names with copy-to-clipboard functionality",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://github.com/*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*/*/pulls*"
      ],
      "js": [
        "content-script.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ],
  "icons": {
    "16": "icons/github-16.png",
    "32": "icons/github-32.png",
    "48": "icons/github-48.png",
    "128": "icons/github-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GitHub Worktrees"
  }
}
